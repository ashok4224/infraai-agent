# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/infraaiagent

# JWT
SECRET_KEY=change-me-to-a-secure-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Default Admin (created on first run)
ADMIN_EMAIL=admin@winfosolutions.com
ADMIN_PASSWORD=ChangeMe123!

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@winfosolutions.com

# App
APP_NAME=InfraAI Agent
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
